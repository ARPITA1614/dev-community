<div class="col-lg-10 mx-auto mt-5">
    <div class="card mb-5">
        <div class="row">
            <div class="col-lg-4">
                <%= image_tag "dummy.jpeg", class: "img-fluid" %>
            </div>
            <div class="col-lg-8">
                <div class="card-body">
                    <h3 class="fw-fold"><%= @user.name%></h3>
                    <p class="lead"><%= @user.profile_title %></p>
                    <p class="lead text-primary"><%= @user.address %></p>
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-5">
        <div class="card-body">
            <div class="row">
            </div>
            <p class="lead"><%= @user.about %></p>
        </div>
    </div>
</div>